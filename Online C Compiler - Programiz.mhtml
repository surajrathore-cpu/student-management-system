#logo { width: 53px; }

#nav-logo { width: 68px; height: 23px; }

.logo-title-wrapper { text-align: left; transform: translateX(0px); left: 0=
px; }

.logo-title-wrapper .logo-sub-title-wrapper { font-size: 10px; line-height:=
